                        <div class="img-wrapper">
                            <img src="/content/dam/banner-engineering/3d-renders/application-notes/indication/cl50pro-label-machine.psd/jcr:content/renditions/cq5dam.web.1280.1280.jpeg" alt="Box Sealer Status Indication" loading="lazy"/>
                        </div>
