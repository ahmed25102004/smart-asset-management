                <li class="card2021 image-left js-show-card-list-cards box-shadow-hover">
                    
                    
                    <a class="card-link" href="https://www.bannerengineering.com/us/en/solutions/status-indication/box-sealer-status-indication.html" aria-label="Box Sealer Status Indication"></a>
